      "\t);",
      "};",
      "export default ${1:Name};"
    ],
    "description": "React functional component template"
  },
  "Export Default Function": {
    "prefix": "fun",
    "body": [
      "export default function() {",
      "\treturn (",
      "\t\t<div>",
      "\t\t\t${0}",
      "\t\t</div>",
      "\t);",
      "}"
    ],
    "description": "Export default function"
  },
  "For Loop": {
    "prefix": "fori",
    "body": ["for (let i = 0; i < ${1:num}; i++) {", "\t${0}", "}"],
